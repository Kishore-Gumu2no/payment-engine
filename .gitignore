# ===========================================
# ROOT .gitignore
# ===========================================

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
*.local

# Environment files (keep .env.example)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE/Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Prisma
prisma/migrations/.migration_lock.toml
generated/prisma/

# Test coverage
coverage/

# Docker
.docker/

# Misc
*.pem
.vercel
.netlify