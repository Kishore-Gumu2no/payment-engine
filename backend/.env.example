# ===========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# PostgreSQL - LOCAL INSTANCE (Docker Compose provides this)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payment_engine?schema=public"

# Redis - Use local Docker Compose Redis or Upstash cloud
# Local: redis://localhost:6379
# Cloud (Upstash): rediss://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# Groq API Key - Get from https://console.groq.com/
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# Backend Port
PORT=3000